<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <changeSet author="druchniewicz" id="220720261200-0">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="requisition" columnName="auto_allocation_enabled"/>
                <not>
                    <columnExists tableName="requisition" columnName="auto_allocation_requested"/>
                </not>
            </and>
        </preConditions>

        <renameColumn tableName="requisition"
                      oldColumnName="auto_allocation_enabled"
                      newColumnName="auto_allocation_requested"
                      columnDataType="BIT(1)"/>
    </changeSet>
</databaseChangeLog>
