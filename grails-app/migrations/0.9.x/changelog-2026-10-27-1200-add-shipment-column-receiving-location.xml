<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <changeSet author="druchniewicz" id="271020261200-0">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="shipment" columnName="receiving_location_id"/>
            </not>
        </preConditions>

        <addColumn tableName="shipment">
            <column name="receiving_location_id" type="CHAR(38)"/>
        </addColumn>
    </changeSet>

    <changeSet author="druchniewicz" id="271020261200-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_shipment_receiving_location"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint
                baseColumnNames="receiving_location_id"
                baseTableName="shipment"
                constraintName="fk_shipment_receiving_location"
                deferrable="false"
                initiallyDeferred="false"
                referencedColumnNames="id"
                referencedTableName="location"
        />
    </changeSet>
</databaseChangeLog>
